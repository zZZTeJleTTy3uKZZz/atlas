{
  "_schema": "issuekit.kinds/1 — виды жалоб как ДАННЫЕ: секции шаблона + какие обязательны. Валидатор (lint) проверяет наличие и непустоту required-секций; render строит пустой шаблон. Основано на чеклисте 'как зарепортить проблему, чтобы вас не возненавидели'.",
  "kinds": {
    "bug": {
      "label": "Баг-репорт",
      "title_hint": "<одно предложение: что сломалось>",
      "sections": [
        {"key": "summary", "label": "Что сломалось", "required": true, "hint": "одно предложение"},
        {"key": "expected", "label": "Ожидал", "required": true, "hint": "X"},
        {"key": "actual", "label": "Получил", "required": true, "hint": "Y"},
        {"key": "versions", "label": "Версии", "required": true, "hint": "библиотека X.Y.Z · язык/рантайм · окружение/брокер · важные подзависимости"},
        {"key": "repro", "label": "Минимальный пример", "required": true, "hint": "копипаст-runnable, 10-20 строк, БЕЗ домена/конфигов/лишних зависимостей"},
        {"key": "traceback", "label": "Полный traceback", "required": true, "hint": "целиком, не скриншот и не последняя строчка"},
        {"key": "steps", "label": "Шаги воспроизведения", "required": false, "hint": "1… 2… 3…"},
        {"key": "tried", "label": "Что уже пробовал", "required": false, "hint": "чтобы не советовали отмёл­енное"}
      ]
    },
    "feature": {
      "label": "Фича-реквест",
      "title_hint": "<задача, которую решаешь — НЕ решение>",
      "sections": [
        {"key": "usecase", "label": "Задача (юзкейс)", "required": true, "hint": "что и ЗАЧЕМ пытаюсь сделать (опиши задачу, а не решение)"},
        {"key": "desired", "label": "Желаемый результат", "required": true, "hint": "что считаю успехом (НЕ конкретное API/решение)"},
        {"key": "current", "label": "Сейчас", "required": false, "hint": "как обхожусь / почему не выходит"},
        {"key": "context", "label": "Контекст", "required": false, "hint": "версии, ограничения"}
      ]
    },
    "handoff": {
      "label": "Передача задачи (агент → агент)",
      "title_hint": "<что передаём и кому>",
      "sections": [
        {"key": "done", "label": "Что сделано", "required": true, "hint": "конкретно: какие файлы/изменения/коммиты"},
        {"key": "remaining", "label": "Что осталось", "required": true, "hint": "чёткий список того, что доделать"},
        {"key": "expected", "label": "Ожидаемый результат (ЦКП)", "required": true, "hint": "измеримый признак, что задача закрыта"},
        {"key": "repro", "label": "Как проверить / воспроизвести", "required": true, "hint": "команды/шаги для запуска и проверки (копипаст)"},
        {"key": "context", "label": "Контекст и версии", "required": true, "hint": "ветка/окружение/зависимости/где лежит код"},
        {"key": "tried", "label": "Что уже пробовал / тупики", "required": false, "hint": "чтобы не повторять отмёл­енное"},
        {"key": "blockers", "label": "Блокеры / риски", "required": false, "hint": "что мешает / на что обратить внимание"}
      ]
    }
  }
}
